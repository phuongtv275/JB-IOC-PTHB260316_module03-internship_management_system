      {"name":"AUTH-02 Login STUDENT_2","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_STUDENT_2\",\"password\":\"qa-password-2\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.collectionVariables.set('student2Token', pm.response.json().data.accessToken);"]}}]},
