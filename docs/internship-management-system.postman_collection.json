      {"name":"AUTH-02 Login MENTOR_2","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_MENTOR_2\",\"password\":\"qa-password-2\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.collectionVariables.set('mentor2Token', pm.response.json().data.accessToken);"]}}]},
