{
  "info": {
    "_postman_id": "a55ab723-99d4-4c51-b979-2a3e4a84c2dd",
    "name": "Internship Management System - Full API Scenario",
    "description": "Run folders in order against a fresh development database. Names prefixed QA_ use {{runId}} and are isolated per run. Requests named SEC/VAL/RULE are expected negative cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', Date.now().toString()); }"]}}],
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080"},{"key":"runId","value":""},
    {"key":"adminToken","value":""},{"key":"mentorToken","value":""},{"key":"mentor2Token","value":""},{"key":"studentToken","value":""},{"key":"student2Token","value":""},
    {"key":"adminId","value":""},{"key":"admin2Id","value":""},{"key":"mentor1Id","value":""},{"key":"mentor2Id","value":""},{"key":"student1Id","value":""},{"key":"student2Id","value":""},
    {"key":"phase1Id","value":""},{"key":"phase2Id","value":""},{"key":"criterion1Id","value":""},{"key":"criterion2Id","value":""},{"key":"criterion3Id","value":""},{"key":"round1Id","value":""},{"key":"round2Id","value":""},{"key":"roundCriterion1Id","value":""},{"key":"roundCriterion2Id","value":""},{"key":"assignment1Id","value":""},{"key":"result1Id","value":""}
  ],
  "item": [
    {"name":"01 - Authentication and users","item":[
      {"name":"AUTH-01 Login ADMIN","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\n  \"username\": \"ADMIN\",\n  \"password\": \"admin\"\n}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"]}}]},
      {"name":"AUTH-05 Current ADMIN","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/auth/me"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.expect(pm.response.json().data.role).to.eql('ADMIN');"]}}]},
      {"name":"AUTH-03 Invalid login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\"username\":\"ADMIN\",\"password\":\"wrong-password\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(401);"]}}]},
      {"name":"AUTH-04 Invalid login body","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\"username\":\"\",\"password\":\"\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"USER-01 Get seeded users and IDs","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/users"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","const users = pm.response.json().data;","pm.collectionVariables.set('adminId', users.find(x => x.username === 'ADMIN').userId);","pm.collectionVariables.set('mentor1Id', users.find(x => x.username === 'MENTOR').userId);","pm.collectionVariables.set('student1Id', users.find(x => x.username === 'STUDENT').userId);"]}}]},
      {"name":"USER-02 Filter users by MENTOR","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/users?role=MENTOR"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.response.json().data.forEach(x => pm.expect(x.role).to.eql('MENTOR'));"]}}]},
      {"name":"USER-05 Create MENTOR_2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_MENTOR_2\",\"password\":\"qa-password-2\",\"fullName\":\"QA Mentor 2\",\"email\":\"qa-{{runId}}-mentor2@example.test\",\"phoneNumber\":\"0900000002\",\"role\":\"MENTOR\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('mentor2Id', pm.response.json().data.userId);"]}}]},
      {"name":"USER-05 Create STUDENT_2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_STUDENT_2\",\"password\":\"qa-password-2\",\"fullName\":\"QA Student 2\",\"email\":\"qa-{{runId}}-student2@example.test\",\"phoneNumber\":\"0900000003\",\"role\":\"STUDENT\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('student2Id', pm.response.json().data.userId);"]}}]},
      {"name":"USER-05 Create ADMIN_2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_ADMIN_2\",\"password\":\"qa-password-2\",\"fullName\":\"QA Admin 2\",\"email\":\"qa-{{runId}}-admin2@example.test\",\"phoneNumber\":\"0900000004\",\"role\":\"ADMIN\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('admin2Id', pm.response.json().data.userId);"]}}]},
      {"name":"USER-06 Duplicate username","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_MENTOR_2\",\"password\":\"qa-password-2\",\"fullName\":\"Duplicate\",\"email\":\"duplicate-{{runId}}@example.test\",\"role\":\"MENTOR\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);","pm.expect(pm.response.json().errorCode).to.eql('DUPLICATE_RESOURCE');"]}}]},
      {"name":"USER-07 Invalid user body","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users","body":{"mode":"raw","raw":"{\"username\":\"\",\"password\":\"short\",\"fullName\":\"\",\"email\":\"invalid\",\"role\":\"INVALID\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"USER-08 Update ADMIN_2","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{admin2Id}}","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_ADMIN_2_UPDATED\",\"password\":\"qa-updated-password\",\"fullName\":\"QA Admin Updated\",\"email\":\"qa-{{runId}}-admin2-updated@example.test\",\"phoneNumber\":\"0900000005\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"USER-09 Disable STUDENT_2","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{student2Id}}/status","body":{"mode":"raw","raw":"{\"isActive\":false}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"USER-09 Disabled user cannot login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/auth/login","body":{"mode":"raw","raw":"{\"username\":\"QA_{{runId}}_STUDENT_2\",\"password\":\"qa-password-2\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(401);"]}}]},
      {"name":"USER-09 Enable STUDENT_2","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{student2Id}}/status","body":{"mode":"raw","raw":"{\"isActive\":true}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"USER-10 Change STUDENT_2 to MENTOR then back","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{student2Id}}/role","body":{"mode":"raw","raw":"{\"role\":\"MENTOR\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"USER-10 Restore STUDENT_2 role","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{student2Id}}/role","body":{"mode":"raw","raw":"{\"role\":\"STUDENT\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"USER-12 Cannot change another ADMIN role","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/users/{{admin2Id}}/role","body":{"mode":"raw","raw":"{\"role\":\"STUDENT\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(403);"]}}]}
    ]},
    {"name":"02 - Profiles and role ownership","item":[
      {"name":"MENT-01 Create MENTOR profile","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/mentors","body":{"mode":"raw","raw":"{\"mentorId\":{{mentor1Id}},\"department\":\"Computer Science\",\"academicRank\":\"MSc\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);"]}}]},
      {"name":"MENT-01 Create MENTOR_2 profile","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/mentors","body":{"mode":"raw","raw":"{\"mentorId\":{{mentor2Id}},\"department\":\"QA Department\",\"academicRank\":\"PhD\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);"]}}]},
      {"name":"STU-01 Create STUDENT profile","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/students","body":{"mode":"raw","raw":"{\"studentId\":{{student1Id}},\"studentCode\":\"QA-{{runId}}-001\",\"major\":\"Computer Science\",\"className\":\"PTHB260316\",\"dateOfBirth\":\"2004-01-01\",\"address\":\"Hanoi\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);"]}}]},
