    {"name":"03 - Phases, criteria, rounds and round criteria","item":[
      {"name":"PHASE-01 Create phase 1","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/internship_phases","body":{"mode":"raw","raw":"{\"phaseName\":\"QA Phase {{runId}}\",\"startDate\":\"2026-09-01\",\"endDate\":\"2026-12-31\",\"description\":\"QA phase\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('phase1Id', pm.response.json().data.phaseId);"]}}]},
      {"name":"PHASE-01 Create phase 2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/internship_phases","body":{"mode":"raw","raw":"{\"phaseName\":\"QA Phase 2 {{runId}}\",\"startDate\":\"2027-01-01\",\"endDate\":\"2027-03-31\",\"description\":\"QA phase 2\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('phase2Id', pm.response.json().data.phaseId);"]}}]},
      {"name":"PHASE-02 Invalid phase dates","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/internship_phases","body":{"mode":"raw","raw":"{\"phaseName\":\"Invalid {{runId}}\",\"startDate\":\"2026-12-31\",\"endDate\":\"2026-09-01\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"PHASE-04 Read phases as STUDENT","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/api/internship_phases/{{phase1Id}}"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"CRIT-01 Create criterion 1","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/evaluation_criteria","body":{"mode":"raw","raw":"{\"criterionName\":\"QA Technical {{runId}}\",\"description\":\"Technical delivery\",\"maxScore\":10}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('criterion1Id', pm.response.json().data.criterionId);"]}}]},
      {"name":"CRIT-01 Create criterion 2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/evaluation_criteria","body":{"mode":"raw","raw":"{\"criterionName\":\"QA Communication {{runId}}\",\"description\":\"Communication\",\"maxScore\":5}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('criterion2Id', pm.response.json().data.criterionId);"]}}]},
      {"name":"CRIT-01 Create independent criterion 3","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/evaluation_criteria","body":{"mode":"raw","raw":"{\"criterionName\":\"QA Delete {{runId}}\",\"description\":\"Cleanup criterion\",\"maxScore\":1}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('criterion3Id', pm.response.json().data.criterionId);"]}}]},
      {"name":"CRIT-02 Invalid max score","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/evaluation_criteria","body":{"mode":"raw","raw":"{\"criterionName\":\"Invalid {{runId}}\",\"maxScore\":0}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"CRIT-04 Read criterion as MENTOR","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{mentorToken}}"}],"url":"{{baseUrl}}/api/evaluation_criteria/{{criterion1Id}}"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"ROUND-01 Create round 1","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/assessment_rounds","body":{"mode":"raw","raw":"{\"phaseId\":{{phase1Id}},\"roundName\":\"QA Round {{runId}}\",\"startDate\":\"2026-12-01\",\"endDate\":\"2026-12-31\",\"description\":\"QA round\",\"criteria\":[{\"criterionId\":{{criterion1Id}},\"weight\":1}]}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('round1Id', pm.response.json().data.roundId);"]}}]},
      {"name":"ROUND-01 Create round 2","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/assessment_rounds","body":{"mode":"raw","raw":"{\"phaseId\":{{phase2Id}},\"roundName\":\"QA Round 2 {{runId}}\",\"startDate\":\"2027-02-01\",\"endDate\":\"2027-03-01\",\"description\":\"Wrong phase test\",\"criteria\":[{\"criterionId\":{{criterion2Id}},\"weight\":1}]}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('round2Id', pm.response.json().data.roundId);"]}}]},
      {"name":"ROUND-02 Invalid round dates","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/assessment_rounds","body":{"mode":"raw","raw":"{\"phaseId\":{{phase1Id}},\"roundName\":\"Invalid {{runId}}\",\"startDate\":\"2026-12-31\",\"endDate\":\"2026-12-01\"}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"ROUND-05 Filter rounds by phase","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/api/assessment_rounds?phase_id={{phase1Id}}"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","pm.response.json().data.forEach(x => pm.expect(x.phaseId).to.eql(+pm.collectionVariables.get('phase1Id')));"]}}]},
      {"name":"RC-01 Find round criterion 1","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/api/round_criteria?round_id={{round1Id}}"},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);","const rc = pm.response.json().data.find(x => x.criterionId === +pm.collectionVariables.get('criterion1Id'));","pm.collectionVariables.set('roundCriterion1Id', rc.roundCriterionId);"]}}]},
      {"name":"RC-02 Add criterion 2 to round 1","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/round_criteria","body":{"mode":"raw","raw":"{\"roundId\":{{round1Id}},\"criterionId\":{{criterion2Id}},\"weight\":0.5}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('roundCriterion2Id', pm.response.json().data.roundCriterionId);"]}}]},
      {"name":"RC-03 Duplicate round criterion","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/round_criteria","body":{"mode":"raw","raw":"{\"roundId\":{{round1Id}},\"criterionId\":{{criterion2Id}},\"weight\":1}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
      {"name":"RC-04 Update round criterion weight","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/round_criteria/{{roundCriterion2Id}}","body":{"mode":"raw","raw":"{\"roundId\":{{round1Id}},\"criterionId\":{{criterion2Id}},\"weight\":0.75}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(200);"]}}]},
      {"name":"RC-05 Cannot change round criterion relationship","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/round_criteria/{{roundCriterion2Id}}","body":{"mode":"raw","raw":"{\"roundId\":{{round2Id}},\"criterionId\":{{criterion2Id}},\"weight\":1}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]}
    ]},
    {"name":"04 - Assignments and assessment results","item":[
      {"name":"ASSIGN-01 Create assignment","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/internship_assignments","body":{"mode":"raw","raw":"{\"studentId\":{{student1Id}},\"mentorId\":{{mentor1Id}},\"phaseId\":{{phase1Id}}}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(201);","pm.collectionVariables.set('assignment1Id', pm.response.json().data.assignmentId);","pm.expect(pm.response.json().data.status).to.eql('PENDING');"]}}]},
      {"name":"ASSIGN-02 Duplicate assignment","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/internship_assignments","body":{"mode":"raw","raw":"{\"studentId\":{{student1Id}},\"mentorId\":{{mentor2Id}},\"phaseId\":{{phase1Id}}}"}},"event":[{"listen":"test","script":{"exec":["pm.response.to.have.status(400);"]}}]},
